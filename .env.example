# Copy to .env and fill in. Only OPENROUTER_API_KEY is needed for photo reading.

# Your OpenRouter key (https://openrouter.ai/keys). Without it the app still
# works; you just type a coffee's details in instead of having them read.
OPENROUTER_API_KEY=

# Any OpenRouter model that accepts images. Leave empty for the default.
OPENROUTER_MODEL=

# Optional. If set, the app asks for this once per device before it will read
# photos, so strangers who find the URL cannot spend your OpenRouter credit.
APP_PASSWORD=

# Port on the host for docker compose.
HOST_PORT=8080
